<Window
    x:Class="MusicAssistant.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MusicAssistant.Controls"
    Title="Lazules">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Space" Invoked="OnSpace" />
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnFindShortcut" />
            <KeyboardAccelerator Modifiers="Menu" Key="Left" Invoked="OnBackShortcut" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title Bar: back button stays interactive, the rest is the drag region. The row is sized to the system caption
             area at runtime (SyncTitleBarHeight), which uses the tall caption buttons for some breathing room, and the
             content is centered in it, level with the caption buttons -->
        <Grid x:Name="TitleBarRow" SizeChanged="OnTitleBarSizeChanged">
            <Grid Padding="4,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Back Button: a 36px square, only there while there is a page to go back to. The slot's width (button plus its 4px gap)
                     animates open and closed so the logo slides over with it; starts closed on the first page -->
                <Grid x:Name="BackSlot" Width="0" HorizontalAlignment="Left">
                    <Button x:Name="BackButton" Style="{StaticResource SubtleButtonStyle}" Width="36" Height="36" Padding="0" Opacity="0" IsEnabled="False" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Center" Click="OnBackClick" ToolTipService.ToolTip="Back" AutomationProperties.Name="Back">
                        <Button.RenderTransform>
                            <TranslateTransform x:Name="BackButtonShift" X="-12" />
                        </Button.RenderTransform>
                        <FontIcon Glyph="&#xE72B;" FontSize="12" />
                    </Button>
                </Grid>
                <!-- /Back Button -->
                <!-- 12px in from the row's 4px padding puts the logo 16px from the window edge, the Windows title bar margin -->
                <Grid x:Name="AppTitleBar" Grid.Column="1" Padding="12,0,8,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- App mark: the Lazules logo (lazules.svg) as vector shapes, so it stays sharp at every scale -->
                    <Viewbox Width="16" Height="16" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                        <Grid Width="256" Height="256">
                            <Ellipse Width="256" Height="256">
                                <Ellipse.Fill>
                                    <LinearGradientBrush MappingMode="Absolute" StartPoint="128,10.556429" EndPoint="128,248.082419">
                                        <GradientStop Color="#3FCBFF" Offset="0" />
                                        <GradientStop Color="#0E8FE0" Offset="1" />
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Path Data="M20,12.536L20,4.18L10,5.847L10,18C10,20.208 8.208,22 6,22C3.792,22 2,20.208 2,18C2,15.792 3.792,14 6,14C6.728,14 7.412,14.195 8,14.536L8,5C8,4.511 8.353,4.094 8.836,4.014L20.836,2.014C21.126,1.965 21.422,2.047 21.646,2.237C21.871,2.427 22,2.706 22,3L22,16C22,18.208 20.208,20 18,20C15.792,20 14,18.208 14,16C14,13.792 15.792,12 18,12C18.728,12 19.412,12.195 20,12.536Z">
                                <Path.RenderTransform>
                                    <MatrixTransform Matrix="7.112821,0,0,7.112821,38.646155,42.646183" />
                                </Path.RenderTransform>
                                <Path.Fill>
                                    <LinearGradientBrush MappingMode="Absolute" StartPoint="0,2.540932" EndPoint="0,20.378024">
                                        <GradientStop Color="#FFFFFF" Offset="0" />
                                        <GradientStop Color="#DCF3FF" Offset="1" />
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>
                        </Grid>
                    </Viewbox>
                    <StackPanel x:Name="AppTitleContent" SizeChanged="OnAppTitleSizeChanged" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="Lazules" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                        <!-- Shown while connected through Music Assistant remote access -->
                        <Border x:Name="RemoteBadge" Padding="6,1" CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed" ToolTipService.ToolTip="Connected remotely through the Music Assistant relay">
                            <TextBlock Text="REMOTE" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Search: centered in the title bar, Task Manager style, with the magnifier inside its left edge. No border
                 at rest; focused, the box shows the accent underline. Its width follows the window (OnTitleBarSizeChanged)
                 and it's a pass-through region, so clicks reach it instead of dragging the window -->
            <Grid x:Name="TitleSearchHost" HorizontalAlignment="Center" VerticalAlignment="Center" Width="460" Visibility="Collapsed" SizeChanged="OnTitleSearchSizeChanged">
                <TextBox
                    x:Name="TitleSearch"
                    PlaceholderText="Search artists, albums, tracks, playlists, radio"
                    Padding="40,7,10,7"
                    MinHeight="36"
                    VerticalContentAlignment="Center"
                    TextChanged="OnTitleSearchTextChanged"
                    KeyDown="OnTitleSearchKeyDown"
                    AutomationProperties.Name="Search">
                    <TextBox.Resources>
                        <!-- Borderless at rest in the light and dark themes only; contrast themes keep the system border so the box stays visible -->
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Default">
                                    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Light">
                                    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="HighContrast" />
                            </ResourceDictionary.ThemeDictionaries>
                        </ResourceDictionary>
                    </TextBox.Resources>
                </TextBox>
                <FontIcon Glyph="&#xE721;" FontSize="14" Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsHitTestVisible="False" />
            </Grid>
            <!-- /Search -->
        </Grid>
        <!-- /Title Bar -->

        <!-- Navigation -->
        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsTitleBarAutoPaddingEnabled="False"
            IsSettingsVisible="False"
            PaneDisplayMode="Auto"
            OpenPaneLength="220"
            ItemInvoked="OnNavItemInvoked">

            <NavigationView.MenuItems>
                <NavigationViewItemHeader Content="Explore" />
                <NavigationViewItem Content="Discover" Tag="home">
                    <NavigationViewItem.Icon>
                        <!-- Compass: Segoe Fluent Icons has none, so ring + needle drawn to match its 1px stroke on the 16px grid -->
                        <PathIcon Data="F0 M0.5,8 A7.5,7.5 0 1 1 15.5,8 A7.5,7.5 0 1 1 0.5,8 Z M1.5,8 A6.5,6.5 0 1 1 14.5,8 A6.5,6.5 0 1 1 1.5,8 Z M11.5,4.5 L9.6,9.6 L4.5,11.5 L6.4,6.4 Z" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Browse" Tag="browse" Icon="Folder" />
                <NavigationViewItemHeader Content="Library" />
                <NavigationViewItem Content="Artists" Tag="artists" Icon="Contact" />
                <NavigationViewItem Content="Albums" Tag="albums">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE93C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Tracks" Tag="tracks" Icon="Audio" />
                <NavigationViewItem Content="Playlists" Tag="playlists">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="AudiobooksItem" Content="Audiobooks" Tag="audiobooks" Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="PodcastsItem" Content="Podcasts" Tag="podcasts" Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE720;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Radio" Tag="radios">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Genres" Tag="genres">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D6;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- User card as a footer item so it lays out like the rest of the pane (icon only when compact) -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="UserItem" Tag="account" SelectsOnInvoked="False">
                    <NavigationViewItem.Resources>
                        <!-- Larger icon slot for the avatar (default 16px) -->
                        <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">28</x:Double>
                    </NavigationViewItem.Resources>
                    <NavigationViewItem.Icon>
                        <BitmapIcon x:Name="UserIcon" ShowAsMonochrome="False" />
                    </NavigationViewItem.Icon>
                    <TextBlock x:Name="UserNameText" TextTrimming="CharacterEllipsis" />
                </NavigationViewItem>
                <!-- Own Settings item (not the built-in one) so Quit can sit directly under it -->
                <NavigationViewItem Content="Settings" Tag="settings" Icon="Setting" />
                <!-- Only way to quit from inside the app when the tray icon (and its Exit) is hidden -->
                <NavigationViewItem x:Name="QuitItem" Content="Quit Lazules" Tag="quit" SelectsOnInvoked="False" Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <InfoBar x:Name="MessageBar" Margin="24,8,24,0" MaxWidth="{StaticResource ContentMaxWidth}" IsClosable="True" />
                <Frame x:Name="ContentFrame" Grid.Row="1" Navigated="OnContentNavigated" />
            </Grid>
        </NavigationView>
        <!-- /Navigation -->

        <!-- Now Playing / Queue: slides up from the player bar and covers sidebar and content, sits above the player bar.
             The slide is driven entirely by SlideQueue in code-behind; no Frame transition, which would fight it on first open.
             The host is clipped to its row (OnQueueHostSizeChanged) so the sliding panel never shows through the translucent
             player bar; it has no background, so clicks pass through it while the queue is closed. -->
        <Grid x:Name="QueueHost" Grid.Row="1" SizeChanged="OnQueueHostSizeChanged">
            <Frame x:Name="QueueFrame" Visibility="Collapsed" />
        </Grid>
        <!-- /Now Playing / Queue -->

        <!-- Login (shown instead of Navigation when signed out) -->
        <Frame x:Name="LoginFrame" Grid.Row="1" Visibility="Collapsed" />

        <!-- Player Bar -->
        <controls:PlayerBar x:Name="Player" Grid.Row="2" Visibility="Collapsed" />
        <!-- /Player Bar -->

        <!-- Offscreen: renders the avatar into a circle for the sidebar icon -->
        <Ellipse x:Name="AvatarStamp" Grid.Row="1" Width="96" Height="96" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Ellipse.Fill>
                <ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill" />
            </Ellipse.Fill>
        </Ellipse>
    </Grid>
</Window>
